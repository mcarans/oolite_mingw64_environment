_realname=gnustep-make
_gitname=tools-make
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=2.9.3+50cf9619
pkgrel=1
pkgdesc="GNUstep build system (mingw-w64)"
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url='https://gnustep.github.org/'
license=('spdx:GPL-3.0-or-later')
makedepends=("${MINGW_PACKAGE_PREFIX}-autotools"
             "${MINGW_PACKAGE_PREFIX}-clang"
             "${MINGW_PACKAGE_PREFIX}-lld"
             "${MINGW_PACKAGE_PREFIX}-libobjc2")
_commit=50cf9619e672fb2ff6825f239b5a172c5dc55630
source=("git+https://github.com/gnustep/${_gitname}#commit=${_commit}")
sha256sums=('SKIP')

pkgver() {
  cd "${srcdir}/${_gitname}"
  # Use short hash
  printf "%s" "2.9.3+$(git rev-parse --short HEAD)"
}

build() {
  mkdir -p "${srcdir}/build-${MSYSTEM}" && cd "${srcdir}/build-${MSYSTEM}"

  # libobjc2 defers exception handling to the C++ library, so link with a C++ library
  case ${MSYSTEM} in
    MINGW*|UCRT*)
      export LDFLAGS="$LDFLAGS -fuse-ld=lld -lstdc++ -lgcc_s"
      ;;
    CLANG*)
      export LDFLAGS="$LDFLAGS -Wl,--no-whole-archive -lc++"
      ;;
  esac

  export CC="$MINGW_PREFIX/bin/clang"
  export CXX="$MINGW_PREFIX/bin/clang++"
  export CFLAGS="$CFLAGS -DSTRICT_APPLE_COMPATIBILITY=1 -Wno-incompatible-pointer-types"

  ../"${_gitname}"/configure \
    --with-library-combo=ng-gnu-gnu \
    --with-runtime-abi=gnustep-2.2 \
    --prefix="${MINGW_PREFIX}" \
    --build="${MINGW_CHOST}" \
    --host="${MINGW_CHOST}" \
    --target="${MINGW_CHOST}"

  make
}
check() {
  cd "${srcdir}/build-${MSYSTEM}"
}

package() {
  cd "${srcdir}/build-${MSYSTEM}"

  make install DESTDIR="${pkgdir}"

  install -Dm644 "${srcdir}/${_gitname}/COPYING" "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/COPYING"
}
